# Add provider keys in Vercel Project Settings → Environment Variables.
# Keep all secrets server-side; never prefix these values with NEXT_PUBLIC_.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-astra
KLAVIYO_PRIVATE_API_KEY=
# The current Carbinox account's Shopify Placed Order metric. Override for another account.
KLAVIYO_CONVERSION_METRIC_ID=XWF6d4
APP_PASSWORD=
# Generate a long random value; used only to sign the HttpOnly workspace session.
APP_SESSION_SECRET=
